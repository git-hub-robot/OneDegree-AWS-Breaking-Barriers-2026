# Copy this file to .env.local and fill in your key to enable AI matching.
# Without a key, the app still works using built-in deterministic rules.

# Your OpenAI API key (server-side only; never exposed to the browser).
OPENAI_API_KEY=

# Optional: override the model (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
